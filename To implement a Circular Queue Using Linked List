#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};
struct Node *front = NULL, *rear = NULL;

void enqueue() {
    int value;
    struct Node *p = malloc(sizeof(struct Node));
    if (p == NULL) {
        printf("Queue Overflow\n");
        return;
    }
    printf("Enter value: ");
    scanf("%d", &value);
    p->data = value;
    if (front == NULL) {
        front = rear = p;
        rear->next = front;
    } else {
        p->next = front;
        rear->next = p;
        rear = p;
    }
}

void dequeue() {
    struct Node *temp;
    if (front == NULL) {
        printf("Queue Underflow\n");
        return;
    }
    temp = front;
    if (front == rear)
        front = rear = NULL;
    else {
        front = front->next;
        rear->next = front;
    }
    printf("Deleted: %d\n", temp->data);
    free(temp);
}

void display() {
    struct Node *temp;
    if (front == NULL) {
        printf("Queue is Empty\n");
        return;
    }
    temp = front;
    do {
        printf("%d ", temp->data);
        temp = temp->next;
    } while (temp != front);
    printf("\n");
}

int main() {
    int choice;
    while (1) {
        printf("\n1.Enqueue  \n2.Dequeue  \n3.Display  \n4.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: enqueue(); break;
            case 2: dequeue(); break;
            case 3: display(); break;
            case 4: return 0;
            default: printf("Invalid Choice\n");
        }
    }
}
