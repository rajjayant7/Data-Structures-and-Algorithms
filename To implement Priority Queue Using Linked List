#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    int priority;
    struct Node *link;
};

struct Node *Root = NULL;

void enqueue()
{
    int value, p;
    struct Node *temp, *q;

    temp = (struct Node *)malloc(sizeof(struct Node));

    printf("Enter value: ");
    scanf("%d", &value);

    printf("Enter priority: ");
    scanf("%d", &p);

    temp->data = value;
    temp->priority = p;

    if (Root == NULL || p < Root->priority)
    {
        temp->link = Root;
        Root = temp;
    }
    else
    {
        q = Root;

        while (q->link != NULL &&
               q->link->priority <= p)
        {
            q = q->link;
        }

        temp->link = q->link;
        q->link = temp;
    }

    printf("Element inserted\n");
}

void dequeue()
{
    struct Node *temp;

    if (Root == NULL)
    {
        printf("Queue Underflow\n");
        return;
    }

    temp = Root;

    printf("Deleted: %d\n", temp->data);

    Root = Root->link;

    free(temp);
}

void display()
{
    struct Node *q = Root;

    if (Root == NULL)
    {
        printf("Queue is empty\n");
        return;
    }

    printf("\nPriority Queue:\n");

    while (q != NULL)
    {
        printf("Value: %d  Priority: %d\n",
               q->data, q->priority);

        q = q->link;
    }
}

int main()
{
    int choice;

    while (1)
    {
        printf("\n1. Enqueue");
        printf("\n2. Dequeue");
        printf("\n3. Display");
        printf("\n4. Exit");

        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                enqueue();
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                exit(0);

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}
